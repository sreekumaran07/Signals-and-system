2.1 Periodic and Aperiodic Signals

clc;
clear;
close all;
t = -5:0.01:5;
x1 = sin(2*pi*t);
x2 = exp(-abs(t));
figure;
subplot(2,1,1);
plot(t,x1,'LineWidth',2);
grid on;
title('Periodic Signal');
xlabel('Time (s)');
ylabel('Amplitude');
subplot(2,1,2);
plot(t,x2,'LineWidth',2);
grid on;
title('Aperiodic Signal');
xlabel('Time (s)');
ylabel('Amplitude');

2.3 Amplitude and Time Scaling of Signals
clc;
clear;
close all;
t = -5:0.01:5;
x = sin(2*pi*t);
x_amp = 2*x;
x_time = sin(2*pi*2*t);
figure;
subplot(3,1,1);
plot(t,x,'LineWidth',2);
grid on;
title('Original Signal x(t)');
xlabel('Time (s)');
ylabel('Amplitude');
subplot(3,1,2);
plot(t,x_amp,'LineWidth',2);
grid on;
title('Amplitude Scaled Signal 2x(t)');
xlabel('Time (s)');
ylabel('Amplitude');
subplot(3,1,3);
plot(t,x_time,'LineWidth',2);
grid on;
title('Time Scaled Signal x(2t)');
xlabel('Time (s)');
ylabel('Amplitude');
